{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@markmap": ["packages/markmap/src/index.ts"],
      "@markmap/core": ["packages/markmap/src/core/index.ts"],
      "@markmap/render": ["packages/markmap/src/render/index.ts"],
      "@markmap/view": ["packages/markmap/src/view/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "tests/**/*.ts",
    "packages/markmap/src/**/*.ts",
    "vite.config.ts"
  ]
}
